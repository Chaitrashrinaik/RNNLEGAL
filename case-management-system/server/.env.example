PORT=5000
NODE_ENV=production

# Database (TiDB Cloud / MySQL)
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=case_management

# JWT Authentication
JWT_SECRET=
JWT_EXPIRE=7d

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Client URLs
CLIENT_URL=http://localhost:5173
CLIENT_PORTAL_URL=http://localhost:5173/client-portal

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# eCourts India API
ECOURTS_API_KEY=
ECOURTS_API_BASE_URL=https://webapi.ecourtsindia.com

# WhatsApp Business (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
