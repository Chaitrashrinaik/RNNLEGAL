# ===== PRODUCTION ENVIRONMENT =====
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env to git.

PORT=5000
NODE_ENV=production

# Database (TiDB Cloud — already in use)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=37JhVhrPZvPc2dM.root
DB_PASSWORD=your_tidb_password
DB_NAME=case_management

# JWT — MUST be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRE=7d

# Email (Gmail SMTP app password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=chaitrashricn09@gmail.com
EMAIL_PASS=your_gmail_app_password

# Client URLs — replace with your real domain
CLIENT_URL=https://your-domain.com
CLIENT_PORTAL_URL=https://your-domain.com/client-portal

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# eCourts India API
ECOURTS_API_KEY=your_ecourts_key
ECOURTS_API_BASE_URL=https://webapi.ecourtsindia.com