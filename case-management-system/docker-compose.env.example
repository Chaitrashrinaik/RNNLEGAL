# ============================================================
# Docker deployment variables for CaseBench
# Copy to a ".env" file next to docker-compose.yml and fill in.
# NEVER commit this file to git.
# ============================================================

# --- Secrets (CHANGE THESE) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=put-a-long-random-secret-here-32-chars-minimum

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=casebench
MYSQL_PASSWORD=change-me-app
MYSQL_DATABASE=case_management

# --- Public URL ---
# Leave VITE_API_URL empty for the single-container setup (API + UI same origin).
# Only set it if you serve the UI from a different host.
VITE_API_URL=

CLIENT_URL=https://your-domain.com
CLIENT_PORTAL_URL=https://your-domain.com/client-portal
APP_PORT=5000

# --- Optional integrations ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ECOURTS_API_KEY=
ECOURTS_API_BASE_URL=https://webapi.ecourtsindia.com